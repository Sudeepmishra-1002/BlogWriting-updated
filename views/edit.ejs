<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-image: linear-gradient(rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.8)),
                url('https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=2029&auto=format&fit=crop');
            background-size: cover;
            background-attachment: fixed;
            min-height: 100vh;
        }

        .form-card { max-width: 800px; margin: 100px auto 50px; border-radius: 15px; border: none; }

        #editor {
            font-family: 'Inter', sans-serif;
            font-size: 1.1rem;
            min-height: 350px;
            border: none !important;
        }

        .ql-toolbar.ql-snow {
            border: none !important;
            border-bottom: 1px solid #eee !important;
            position: sticky;
            top: 0;
            z-index: 100;
            background: white;
        }

        .ql-container.ql-snow { border: none !important; }

        @media (max-width: 768px) {
            .ql-toolbar.ql-snow { display: flex; flex-wrap: wrap; }
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top px-3 shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-3" href="/posts">
                <i class="bi bi-chat-square-quote-fill text-primary"></i> Discuss
            </a>
            <div class="ms-auto">
                <a href="/posts/<%= post.id %>" class="btn btn-outline-light btn-sm rounded-pill">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="card form-card shadow-lg">
            <div class="card-header bg-primary text-white p-4" style="border-radius: 15px 15px 0 0;">
                <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Post</h3>
                <small class="text-white-50">Make changes to your thought</small>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4 shadow-sm">
                    <div>
                        <small class="text-muted d-block">Author</small>
                        <strong>@<%= post.username %></strong>
                    </div>
                    <span class="badge bg-secondary">Topic: <%= post.topic_name %></span>
                </div>

                <form id="editForm" method="post" action="/posts/<%= post.id %>?_method=PATCH">
                    
                    <div class="mb-3 border rounded shadow-sm">
                        <div id="editor">
                            <%- post.content %> </div>
                    </div>

                    <input type="hidden" name="content" id="contentInput">

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div id="wordCount" class="text-muted small">Checking words...</div>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Initialize Quill
        var quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Edit your story...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, false] }],
                    ['bold', 'italic', 'underline'],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });

        // Word Count Logic
        function updateWordCount() {
            var text = quill.getText().trim();
            var words = text.length > 0 ? text.split(/\s+/).length : 0;
            var time = Math.ceil(words / 200);
            document.getElementById('wordCount').innerText = words + " words • " + time + " min read";
        }

        // Run word count on load and on change
        updateWordCount();
        quill.on('text-change', updateWordCount);

        // Handle Form Submission
        var form = document.getElementById('editForm');
        form.onsubmit = function () {
            var contentInput = document.getElementById('contentInput');
            // Editor ka updated HTML content hidden field mein daalna
            contentInput.value = quill.root.innerHTML;
            return true;
        };
    </script>
</body>

</html>