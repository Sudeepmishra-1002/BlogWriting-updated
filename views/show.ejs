<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post Detail</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
        }
        .navbar {
            background-color: rgba(33, 37, 41, 0.98) !important;
            backdrop-filter: blur(10px);
        }
        .article-container {
            max-width: 800px; /* Reading ke liye best width */
            margin: auto;
        }
        .author-avatar {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 50%;
        }
        .post-content {
            font-size: 1.2rem;
            line-height: 1.8;
            color: #333;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top px-3 shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-3" href="/posts">
                <i class="bi bi-chat-square-quote-fill text-primary"></i> Discuss
            </a>
            <div class="ms-auto">
                <a href="/posts" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-5 pt-5 mb-5">
        <div class="article-container bg-white p-5 shadow-sm rounded-4 mt-4">
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/posts" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Post Detail</li>
                </ol>
            </nav>

            <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                <img src="https://api.dicebear.com/9.x/avataaars/svg?seed=<%= post.username %>" class="author-avatar shadow-sm border me-3">
                <div>
                    <h5 class="mb-0 fw-bold text-dark">@<%= post.username %></h5>
                    <small class="text-muted">Posted recently • <span class="badge bg-primary bg-opacity-10 text-primary">#<%= post.topic_name %></span></small>
                </div>
                
                <div class="ms-auto">
                    <a href="/posts/<%= post.id %>/edit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                </div>
            </div>

            <% if (post.image) { %>
                <div class="mb-4">
                    <img src="<%= post.image %>" class="img-fluid rounded-3 shadow-sm w-100" alt="Post Image">
                </div>
            <% } %>

            <div class="post-content">
                <p><%= post.content %></p>
            </div>

            <div class="mt-5 pt-3 border-top d-flex gap-3">
                <button class="btn btn-outline-danger rounded-pill px-4">
                    <i class="bi bi-heart"></i> Like
                </button>
                <button class="btn btn-outline-dark rounded-pill px-4">
                    <i class="bi bi-share"></i> Share
                </button>
            </div>

        </div>

        <div class="article-container mt-4">
            <h4 class="mb-3">Comments (2)</h4>
            
            <div class="card border-0 shadow-sm p-3 mb-3">
                <div class="d-flex">
                    <img src="https://api.dicebear.com/9.x/avataaars/svg?seed=Felix" class="rounded-circle me-3" width="40">
                    <div>
                        <h6 class="fw-bold mb-1">Felix Dude</h6>
                        <p class="mb-0 text-secondary">Wow, this is a great thought! Totally agree.</p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex">
                    <img src="https://api.dicebear.com/9.x/avataaars/svg?seed=Anna" class="rounded-circle me-3" width="40">
                    <div>
                        <h6 class="fw-bold mb-1">Anna Smith</h6>
                        <p class="mb-0 text-secondary">Thanks for sharing this info.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>