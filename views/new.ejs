<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write New Post</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

    <style>
        /* 1. Global & Background Styling */
        body {
            font-family: 'Poppins', sans-serif;
            background-image: linear-gradient(rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.8)),
                url('https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=2029&auto=format&fit=crop');
            background-size: cover;
            background-attachment: fixed;
            min-height: 100vh;
        }

        /* 2. Card & Form Layout */
        .form-card {
            max-width: 800px;
            margin: 100px auto 50px;
            border-radius: 15px;
            border: none;
        }

        .form-control:focus {
            outline: none !important;
            box-shadow: none !important;
        }

        /* 3. Quill Editor Styling (Medium Style) */
        #editor {
            font-family: 'Inter', sans-serif;
            font-size: 1.1rem;
            min-height: 350px;
            border: none !important;
        }

        .ql-toolbar.ql-snow {
            border: none !important;
            border-bottom: 1px solid #eee !important;
            position: sticky;
            /* Toolbar typing ke waqt top pe rahega */
            top: 0;
            z-index: 100;
            background: white;
        }

        .ql-container.ql-snow {
            border: none !important;
        }

        #imagePreview {
            max-height: 300px;
            object-fit: cover;
            display: none;
        }

        /* 4. Mobile responsiveness */
        @media (max-width: 768px) {
            .ql-toolbar.ql-snow {
                display: flex;
                flex-wrap: wrap;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top px-3 shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-3" href="/posts">
                <i class="bi bi-chat-square-quote-fill text-primary"></i> Discuss
            </a>
        </div>
    </nav>

    <div class="container">
        <div class="card form-card shadow-lg">
            <div class="card-header bg-success text-white p-4" style="border-radius: 15px 15px 0 0;">
                <h3 class="mb-0 fw-bold"><i class="bi bi-pen-fill me-2"></i> Write a New Post</h3>
            </div>

            <div class="card-body p-4 p-md-5">
                <form action="/posts" method="POST" id="postForm" enctype="multipart/form-data">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <input type="text" name="username" class="form-control border-0 fs-5 fw-bold shadow-none"
                                placeholder="Your Name" required>
                        </div>
                        <div class="col-md-6">
                            <input type="text" name="topic_name"
                                class="form-control border-0 fs-5 shadow-none text-muted"
                                placeholder="Topic (e.g. Coding)" required>
                        </div>
                    </div>

                    <div class="mb-3 border rounded shadow-sm">
                        <div id="editor"></div>
                    </div>

                    <input type="hidden" name="content" id="contentInput">

                    <div class="mb-4 mt-4">
                        <label for="image" class="form-label fw-bold text-secondary">Add a Cover Image</label>
                        <input id="image" type="file" class="form-control" name="image" accept="image/*"
                            onchange="previewImage(event)">
                        <div class="mt-3 text-center">
                            <img id="imagePreview" class="img-fluid rounded shadow-sm border" alt="Image Preview">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div id="wordCount" class="text-muted small">0 words • 0 min read</div>
                        <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm">
                            Publish Post
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Image Preview Logic
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                const output = document.getElementById('imagePreview');
                output.src = reader.result;
                output.style.display = 'block';
            };
            if (event.target.files[0]) reader.readAsDataURL(event.target.files[0]);
        }

        // Initialize Quill
        var quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Write your story...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, false] }],
                    ['bold', 'italic', 'underline'],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });

        // Word Count & Read Time
        quill.on('text-change', function () {
            var text = quill.getText().trim();
            var words = text.length > 0 ? text.split(/\s+/).length : 0;
            var time = Math.ceil(words / 200);
            document.getElementById('wordCount').innerText = words + " words • " + time + " min read";
        });

        // Submit Logic
        var form = document.getElementById('postForm');
        form.onsubmit = function () {
            var contentInput = 
            document.getElementById('contentInput');
            contentInput.value = quill.root.innerHTML;
            return true;
        };
    </script>
</body>

</html>