<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discuss - Home</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            transition: background 0.3s, color 0.3s;
            min-height: 100vh;
        }

        /* LIGHT MODE (Standard) Styling */
        [data-bs-theme="light"] body {
            background-image: linear-gradient(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.9)),
                url('https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=2029&auto=format&fit=crop');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
        }

        /* DARK MODE Styling */
        [data-bs-theme="dark"] body {
            background-color: #121212 !important;
            background-image: none;
            /* Image hata di taaki dark dikhe */
        }

        /* Dark mode mein cards ko thoda alag dikhana */
        [data-bs-theme="dark"] .card {
            background-color: #1e1e1e;
            border: 1px solid #333;
        }

        .card {
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15) !important;
        }

        /* Text Limit */
        .post-preview-text {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .navbar {
            backdrop-filter: blur(10px);
            background-color: rgba(33, 37, 41, 0.95) !important;
            /* Hamesha Dark Navbar */
        }

        /* Floating Button */
        .floating-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            z-index: 1000;
            transition: all 0.3s;
        }

        .floating-btn:hover {
            transform: scale(1.1);
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top px-3 shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-3" href="/posts">
                <i class="bi bi-chat-square-quote-fill text-primary"></i> Discuss
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">

                <form class="d-flex mx-auto my-2 my-lg-0" role="search" action="/posts" method="GET"
                    style="max-width: 400px; width: 100%;">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i
                                class="bi bi-search text-secondary"></i></span>
                        <input class="form-control border-0 bg-light" type="search" placeholder="Search topics..."
                            name="search">
                    </div>
                </form>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 fs-5 gap-2 text-end align-items-center">

                    <li class="nav-item me-2">
                        <button class="btn btn-outline-light rounded-circle" id="themeToggle" title="Toggle Night Mode">
                            <i class="bi bi-moon-fill" id="themeIcon"></i>
                        </button>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/posts">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/posts/new">Write</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="#">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- <div class="container text-center mt-5 pt-5 mb-5">
        <div class="py-4"> -->
            <div class="container text-center mt-5 pt-4 mb-3">
                <div class="py-2">
            <!-- <h1 class="display-4 fw-bold mb-3"> -->
                <h1 class="display-5 fw-bold mb-2">
                Share Your <span class="text-primary">Thoughts.</span><br>
                Inspire the <span
                    style="background: linear-gradient(to right, #f32170, #ff6b08, #cf23cf); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">World.</span>
            </h1>
            <!-- <p class="lead text-secondary mb-4"> -->
                <p class="lead text-secondary mb-2">
                Join the community of developers and creators sharing ideas every day.
            </p>
        </div>
    </div>

    <div class="container pb-5">
        <% posts.forEach(post=> { %>
            <!-- <div class="card mb-4 border-0 shadow-sm">
                <div class="card-body p-4"> -->
                    <div class="card mb-2 border-0 shadow-sm">
                        <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <img src="https://api.dicebear.com/9.x/avataaars/svg?seed=<%= post.username %>"
                                class="rounded-circle border border-2 border-secondary shadow-sm me-2" width="50"
                                height="50">
                            <div>
                                <h5 class="card-title mb-0 fw-bold">@<%= post.username %>
                                </h5>
                                <small class="text-muted" style="font-size: 0.8rem;">
                                    <p class="time">
                                        <%= format(post.postedAt) %>
                                    </p>
                                </small>
                            </div>
                        </div>
                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                            #<%= post.topic_name %>
                        </span>
                    </div>

                    <% if(post.image) { %>
                        <div class="post-image-container mb-3">
                            <img src="<%= post.image %>" class="img-fluid rounded shadow-sm w-100"
                                style="max-height: 400px; object-fit: cover;" alt="Blog Image">
                        </div>
                        <% } %>

                            <p class="card-text text-secondary post-preview-text"
                                style="font-size: 0.95rem; line-height: 1.4;">
                                <%- post.content %>[cite:24]
                            </p>
                            <hr class="text-muted opacity-25">

                            <div class="d-flex gap-3 align-items-center">
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-heart-fill"></i>
                                    <%= post.likes || 12 %>
                                </button>
                                <div class="ms-auto">
                                    <a href="/posts/<%= post.id %>" class="btn btn-sm btn-primary">Read More</a>
                                    <a href="/posts/<%= post.id %>/edit" class="btn btn-sm btn-outline-secondary"><i
                                            class="bi bi-pencil"></i></a>
                                </div>
                            </div>
                </div>
            </div>
            <% }) %>
    </div>

    <a href="/posts/new" class="btn btn-primary floating-btn">
        <i class="bi bi-plus-lg fs-3 text-white"></i>
    </a>

    <script>
        const toggleBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const htmlElement = document.documentElement;

        // 1. Check Local Storage on Load (Taaki refresh par mode yaad rahe)
        const savedTheme = localStorage.getItem('theme') || 'light';
        htmlElement.setAttribute('data-bs-theme', savedTheme);
        updateIcon(savedTheme);

        // 2. Button Click Logic
        toggleBtn.addEventListener('click', () => {
            const currentTheme = htmlElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';

            // Apply new theme
            htmlElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme', newTheme); // Save to browser memory
            updateIcon(newTheme);
        });

        // 3. Icon Changer (Sun vs Moon)
        function updateIcon(theme) {
            if (theme === 'dark') {
                themeIcon.classList.remove('bi-moon-fill');
                themeIcon.classList.add('bi-sun-fill'); // Dark mode mein Sun dikhao
            } else {
                themeIcon.classList.remove('bi-sun-fill');
                themeIcon.classList.add('bi-moon-fill'); // Light mode mein Moon dikhao
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>