<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Discuss</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Poppins', sans-serif;
        }
        .bg-image {
            background-image: url('/images/signup-bg.jpg'); /* Same Image */
            height: 100%;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            position: relative;
        }
        .overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(0, 0, 0, 0.3);
        }
        .glass-card {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 100%; max-width: 420px; padding: 40px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        .form-control:focus { box-shadow: none; border-color: #6c5ce7; }
        .btn-brand {
            background: linear-gradient(45deg, #6c5ce7, #a29bfe);
            border: none; color: white; font-weight: 600; padding: 12px;
            transition: transform 0.2s;
        }
        .btn-brand:hover { transform: scale(1.02); color: white; }
    </style>
</head>
<body>

    <div class="bg-image">
        <div class="overlay"></div>

        <a href="/posts" class="btn btn-light btn-sm position-absolute top-0 start-0 m-4 rounded-pill px-3 shadow-sm" style="z-index: 10;">
            <i class="bi bi-arrow-left"></i> Home
        </a>

        <div class="glass-card text-center">
            <h2 class="mb-4 fw-bold text-dark">Welcome Back</h2>
            <p class="text-muted mb-4">Please login to continue.</p>

            <% if (error) { %>
                <div class="alert alert-danger py-2 small rounded-3 mb-3"><%= error %></div>
            <% } %>

            <form action="/login" method="POST">
                <div class="form-floating mb-3">
                    <input type="email" class="form-control rounded-3" id="email" name="email" placeholder="name@example.com" required>
                    <label for="email">Email address</label>
                </div>

                <div class="form-floating mb-4">
                    <input type="password" class="form-control rounded-3" id="password" name="password" placeholder="Password" required>
                    <label for="password">Password</label>
                </div>

                <button type="submit" class="btn btn-brand w-100 rounded-pill mb-3 shadow">
                    Login
                </button>

                <div class="text-muted small">
                    Don't have an account? <a href="/signup" class="text-primary text-decoration-none fw-bold">Sign Up</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>